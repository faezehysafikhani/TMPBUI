# PORT: Port the Express server listens on (defaults to 3000).

# Link-preview metadata (Open Graph/Twitter tags) needs no configuration: server.ts derives the
# public URL from the request's own Host header at request time (see server.ts).

# ---------------------------------------------------------------------------
# NexusCore backend (REST API) - deployment (production/staging): use API_BASE_URL
# ---------------------------------------------------------------------------
# API_BASE_URL: origin of the NexusCore API, without a trailing slash, e.g.
# http://192.168.x.x:5151 or https://your-domain.example. Everything - sign-in, profiles, user
# administration, SMS and LDAP settings, teams, tasks, files, comments, history, notes, chat and
# live updates - is served by NexusCore; it is the app's only backend.
#
# Read by server.ts from ITS OWN process environment on every request (see the /runtime-config.js
# route) - NOT embedded into the built JS. This is what lets the same `npm run build` output be
# deployed at a different backend host by only changing this one value and restarting the server -
# no rebuild, no source edit. Leave empty for same-origin (the app calls whatever host served it;
# use that when a reverse proxy serves the app and the API under one address - the simplest and
# most robust setup under IIS).
#
# The origin serving this app must be listed in the backend's Cors:AllowedOrigins.
PORT=3030
API_BASE_URL=http://localhost:5151

# ---------------------------------------------------------------------------
# Local development only (plain `vite`/`vite preview`, not through server.ts)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL: same purpose as API_BASE_URL above, but embedded into the JS bundle AT BUILD
# TIME by Vite - so it only takes effect after a rebuild, and must NOT be relied on for a real
# deployment (that's exactly what API_BASE_URL above is for). Only used as a fallback when
# window.__RUNTIME_CONFIG__ isn't present, i.e. Vite's own dev server/build, not server.ts.
VITE_API_BASE_URL=http://localhost:5151

# VITE_NEXUS_TENANT_SLUG: optional tenant slug sent with sign-in (multi-tenant installs).
VITE_NEXUS_TENANT_SLUG=""

# VITE_API_TIMEOUT_MS: request timeout in milliseconds (default 30000).
VITE_API_TIMEOUT_MS=""
