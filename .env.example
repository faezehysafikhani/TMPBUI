# PORT: Port the Express server listens on (defaults to 3000).


# APP_URL: The public URL where this app is hosted.
# Used for self-referential links and link-preview metadata.
APP_URL="https://task.parspmi.ir"

# ---------------------------------------------------------------------------
# NexusCore backend (REST API)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL: origin of the NexusCore API, without a trailing slash.
# When set, tasks, subtasks, recurring schedules, tags, comments, activity, notes,
# sign-in and the user list are served by NexusCore instead of PocketBase.
# Leave it empty to keep the app on PocketBase exactly as before.
# Read at build time (Vite), so rebuild after changing it.
# The origin serving this app must be listed in the backend's Cors:AllowedOrigins.
PORT=3030
VITE_API_BASE_URL=http://localhost:5151

# VITE_NEXUS_TENANT_SLUG: optional tenant slug sent with sign-in (multi-tenant installs).
VITE_NEXUS_TENANT_SLUG=""

# VITE_NEXUS_LOGIN_EMAIL_DOMAIN: lets users sign in with a username. NexusCore accepts only
# an email, so a username without "@" is sent as <username>@<domain> (Admin -> admin@taskmanager.local).
VITE_NEXUS_LOGIN_EMAIL_DOMAIN=""

# VITE_API_TIMEOUT_MS: request timeout in milliseconds (default 30000).
VITE_API_TIMEOUT_MS=""
