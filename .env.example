# Front-end settings. Copy this file to .env and fill it in; .env is not committed.
# The VITE_* values are read by the app itself (in `npm run dev` straight away, in `npm run build`
# they are built in). The others are read by the Node server (server.ts).

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# VITE_API_BASE_URL: the backend the app sends its requests to, e.g. https://localhost:7271.
# Empty: the app calls its own origin (/api/...). In development the dev server then passes
# /api and /hubs on to API_PROXY_TARGET below; in production a reverse proxy does that.
VITE_API_BASE_URL=""

# VITE_SIGNALR_BASE_URL: the SignalR (live updates) origin. Empty: the same as VITE_API_BASE_URL.
VITE_SIGNALR_BASE_URL=""

# VITE_NEXUS_TENANT_SLUG: optional tenant slug sent with sign-in (multi-tenant installs).
VITE_NEXUS_TENANT_SLUG=""

# VITE_API_TIMEOUT_MS: request timeout in milliseconds (default 30000).
VITE_API_TIMEOUT_MS="30000"

# VITE_ALLOWED_API_ORIGINS: optional, comma separated. When set, a cross-origin apiBaseUrl written
# into config/runtime-config.json on an installed server is accepted only if its origin is listed.
VITE_ALLOWED_API_ORIGINS=""

# ---------------------------------------------------------------------------
# Node server (npm run dev / npm start)
# ---------------------------------------------------------------------------

# PORT: the port the server listens on.
PORT=3000

# API_PROXY_TARGET: development only. Where /api and /hubs are passed on to when
# VITE_API_BASE_URL is empty (page and API on one origin, as in production). Default https://localhost:7271.
API_PROXY_TARGET="https://localhost:7271"

# CSP_REPORT_URI / CSP_CONNECT_SRC: production only, when the API is on another origin. Its address
# for the CSP report endpoint and for connect-src, e.g.
#   CSP_REPORT_URI=http://localhost:7271/api/platform/csp-report
#   CSP_CONNECT_SRC="http://localhost:7271 ws://localhost:7271"
CSP_REPORT_URI=""
CSP_CONNECT_SRC=""

# Note: on an installed server, config/runtime-config.json (in the build output) can still override
# the backend settings without a rebuild. Only a value it sets counts; the shipped file is empty,
# so the values above stay in force.
